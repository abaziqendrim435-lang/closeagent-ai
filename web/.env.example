# Neon (Console → project "closeagentai" → Connect → copy the pooled connection string)
DATABASE_URL=postgresql://...

# Neon Managed Better Auth (already enabled on the "production" branch)
NEON_AUTH_BASE_URL=https://ep-gentle-snow-b42k9viq.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# Any random string, 32+ characters (e.g. `openssl rand -base64 32`)
NEON_AUTH_COOKIE_SECRET=

# OpenAI (server-side; usage is limited per plan)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# Hunter.io (optional, enables "Find companies")
HUNTER_API_KEY=

# Stripe (optional until you start charging)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
